{
  "name": "a3",
  "version": "0.1.0",
  "private": true,
  "description": "Git-connected static frontend deployment to Internet Computer canisters.",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace backend",
    "dev:ui": "npm run dev --workspace frontend",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build --workspace frontend",
    "test": "npm test --workspace backend",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "demo": "npm run build && node scripts/demo-server.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
