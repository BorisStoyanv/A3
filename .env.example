# Copy to backend/.env for local development. Fill empty secrets locally.
# Never commit the completed file. Kubernetes uses Secret references instead.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/a3
DB_POOL_MAX=10
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
LOCAL_AUTH_ENABLED=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=

# Generate with: openssl rand -base64 32
ENV_VARS_ENCRYPTION_PROVIDER=local_encrypted
ENV_VARS_MASTER_KEY=
ENV_VARS_MASTER_KEY_VERSION=v1
# Alternative to the local master key: gcp_kms plus a full KMS key resource name.
ENV_VARS_KMS_KEY_NAME=

# GitHub App: OAuth identity plus repository installation access.
# Existing users must reconnect after migration 025 to authorize installations.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PEM=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_STATE_SECRET=

# Optional GitLab integration (gitlab.com).
GITLAB_ENABLED=false
GITLAB_BASE_URL=https://gitlab.com
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_OAUTH_STATE_SECRET=
GITLAB_BETA_ALLOWLIST=

# Optional Stripe billing; leave disabled for a local source review.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# Customer builds must run in isolated Kubernetes Jobs.
DEPLOY_MODE=job
DEPLOY_MODE_TYPE=hosted
WORKSPACE_NAMESPACE=workspace-alpha
DEPLOY_JOB_IMAGE=REPLACE_WITH_YOUR_RUNNER_IMAGE
DEPLOY_IMAGE_PULL_SECRET=
DEPLOY_BUILD_SERVICE_ACCOUNT=workspace-alpha-build-runner
DEPLOY_DEPLOY_SERVICE_ACCOUNT=workspace-alpha-deploy-runner
DEPLOY_WORKDIR_BASE=/workspace/storage
DEPLOY_MAX_ACTIVE_DEPLOYMENTS=3
DEPLOY_IDENTITY_NAME=
DEPLOY_IDENTITY_SECRET=identity-uploader-a3
DEPLOY_IDENTITY_PEM=/workspace/identity/identity.pem
ICP_NETWORK=local
DFX_IDENTITY=
DEPLOY_REPLICA_HOST=icp-replica.workspace-alpha.svc.cluster.local:4943
HOST_BASE_DOMAIN=example.com
HOST_ALIAS_LABEL_SEPARATOR=--

# Generate an Ed25519 signing key outside the checkout. Configure the matching
# public verification key on the host canister. These are not customer variables.
DEPLOY_TICKET_ENABLED=true
DEPLOY_TICKET_GUARDRAIL_STRICT=true
DEPLOY_TICKET_KEY_ID=1
DEPLOY_TICKET_PRIVATE_KEY_PEM=
EJECT_ENABLED=false
